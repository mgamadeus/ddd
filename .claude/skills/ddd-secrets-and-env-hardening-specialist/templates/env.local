# .env.local — per-developer override, NEVER committed (gitignored). Reaches a remote dev
# workspace only through the IDE's rsync/deployment sync, never a prod checkout.
#
# Precedence (weak -> strong):
#   .env  <  .env.local  <  .env.$APP_ENV  <  .env.$APP_ENV.local  <  real env (op run / docker)
#
# Rules:
#   - dev/debug flags live HERE, the committed .env stays prod-safe (APP_ENV=prod, APP_DEBUG=0).
#   - ad-hoc secrets for features still in development go HERE (dev values only).
#     When the feature ships: value -> .env_backup -> op_import_env_secrets.py -> 1Password item,
#     KEY=op://... -> committed .env, and the line is removed from this file.
#   - a PROD secret never belongs in this file.
#   - OP_VAULT does NOT belong here: op run expands it from the process env only (see .envrc).

APP_ENV=dev
APP_DEBUG=1
PUBLIC_URL={{DEV_PUBLIC_URL}}

# --- ad-hoc / temporary dev secrets below (dev values only) ---
# NEW_FEATURE_API_KEY=...
