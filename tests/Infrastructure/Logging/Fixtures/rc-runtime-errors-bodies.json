{
    "groups_default": {
        "size": 0,
        "query": {
            "bool": {
                "filter": [
                    {
                        "range": {
                            "@timestamp": {
                                "gte": "now-24h"
                            }
                        }
                    },
                    {
                        "terms": {
                            "log.level.keyword": [
                                "ERROR",
                                "CRITICAL"
                            ]
                        }
                    }
                ]
            }
        },
        "aggs": {
            "by_fingerprint": {
                "multi_terms": {
                    "terms": [
                        {
                            "field": "error.type.keyword",
                            "missing": "—"
                        },
                        {
                            "field": "log.origin.file.name.keyword",
                            "missing": "—"
                        }
                    ],
                    "size": 50,
                    "order": {
                        "_count": "desc"
                    }
                },
                "aggs": {
                    "latest": {
                        "top_hits": {
                            "size": 1,
                            "sort": [
                                {
                                    "@timestamp": "desc"
                                }
                            ],
                            "_source": [
                                "message",
                                "error.type",
                                "error.stack_trace",
                                "route_name",
                                "@timestamp",
                                "error.fingerprint_hash",
                                "error.fingerprint_short",
                                "lastLocationId",
                                "error.code",
                                "error.kind",
                                "log.origin.file.name",
                                "log.origin.file.line",
                                "environment",
                                "workspace"
                            ]
                        }
                    },
                    "affected_locations": {
                        "cardinality": {
                            "field": "lastLocationId"
                        }
                    },
                    "first_seen": {
                        "min": {
                            "field": "@timestamp",
                            "format": "strict_date_optional_time"
                        }
                    }
                }
            }
        }
    },
    "groups_fingerprint_filters": {
        "size": 0,
        "query": {
            "bool": {
                "filter": [
                    {
                        "range": {
                            "@timestamp": {
                                "gte": "now-72h"
                            }
                        }
                    },
                    {
                        "terms": {
                            "log.level.keyword": [
                                "ERROR"
                            ]
                        }
                    },
                    {
                        "term": {
                            "account.id": 4183511
                        }
                    },
                    {
                        "term": {
                            "lastLocationId": 77
                        }
                    },
                    {
                        "bool": {
                            "should": [
                                {
                                    "wildcard": {
                                        "route_name.keyword": {
                                            "value": "*App\\\\Foo\\*\\?*",
                                            "case_insensitive": true
                                        }
                                    }
                                },
                                {
                                    "wildcard": {
                                        "error.type.keyword": {
                                            "value": "*App\\\\Foo\\*\\?*",
                                            "case_insensitive": true
                                        }
                                    }
                                }
                            ],
                            "minimum_should_match": 1
                        }
                    },
                    {
                        "term": {
                            "workspace.keyword": "mgn"
                        }
                    }
                ]
            }
        },
        "aggs": {
            "by_fingerprint": {
                "terms": {
                    "field": "error.fingerprint_short.keyword",
                    "size": 20,
                    "order": {
                        "_count": "desc"
                    }
                },
                "aggs": {
